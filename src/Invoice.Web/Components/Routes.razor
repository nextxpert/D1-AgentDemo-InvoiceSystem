<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                <main class="page-shell"><section class="notice"><div><h1>Sign in to continue</h1><p>The interactive assistant acts only for the signed-in user.</p></div><a class="button primary" href="/sign-in">Sign in</a></section></main>
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound><LayoutView Layout="typeof(Layout.MainLayout)"><main class="page-shell"><h1>Page not found</h1></main></LayoutView></NotFound>
</Router>
